rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    /*
     * Wewenang dibaca dari custom claims di token, bukan dari dokumen Firestore.
     *
     * Sebelumnya tiap pemeriksaan memanggil get() ke adminUsers/{uid}. Itu
     * berarti akun baru tidak bisa berbuat apa-apa sampai ada yang membuatkan
     * dokumennya dengan tangan, dan tiap operasi tulis membayar pembacaan
     * tambahan. Claims ikut di dalam token yang sudah ditandatangani Google,
     * jadi jawabannya sudah ada sebelum basis data disentuh.
     *
     * Claims hanya bisa dipasang Admin SDK lewat /api/admin/accounts. Klien
     * tidak punya cara mengarangnya sendiri.
     *
     * Memakai .get() dengan nilai bawaan, bukan akses field langsung: token
     * tanpa claims sama sekali adalah keadaan yang normal (pengunjung biasa),
     * dan akses field yang tidak ada membuat seluruh aturan gagal dievaluasi.
     */
    function adminRole() {
      return isSignedIn() ? request.auth.token.get('role', '') : '';
    }

    function hasActiveAdminProfile() {
      return adminRole() in ['superadmin', 'editor', 'viewer'];
    }

    function hasRole(roles) {
      return adminRole() in roles;
    }

    function isEditor() {
      return hasRole(['superadmin', 'editor']);
    }

    function isSuperadmin() {
      return hasRole(['superadmin']);
    }

    /*
     * Bidang yang dipegang akun ini. Akun nonaktif tidak punya `role` sama
     * sekali di claims-nya, jadi ia sudah gugur di adminRole() sebelum sampai
     * ke sini. Tidak ada bendera aktif kedua yang bisa terlupa diperiksa.
     */
    function adminDivisionCode() {
      return isSignedIn() ? request.auth.token.get('divisionCode', '') : '';
    }

    /*
     * Superadmin bebas. Editor hanya boleh menyentuh data bidangnya sendiri.
     *
     * Dokumen tanpa `divisionCode`, dan akun editor tanpa bidang, keduanya
     * jatuh ke string kosong dan ditolak. Ini disengaja: data yatim harus
     * ditangani superadmin, bukan jadi celah yang bisa diklaim editor mana pun
     * hanya karena bidangnya sama-sama kosong.
     */
    function canManageDivision(code) {
      return isSuperadmin()
        || (isEditor() && code is string && code != '' && adminDivisionCode() == code);
    }

    function ownsExistingDivision() {
      return canManageDivision(resource.data.get('divisionCode', ''));
    }

    /*
     * Perubahan harus dimiliki di kedua sisi. Tanpa pemeriksaan dua arah,
     * seorang editor bisa memindahkan pengurus bidang lain ke bidangnya, atau
     * membuang anggotanya sendiri ke bidang orang lain.
     */
    function ownsDivisionChange() {
      return canManageDivision(resource.data.get('divisionCode', ''))
        && canManageDivision(request.resource.data.get('divisionCode', ''));
    }

    function isValidContentStatus(status) {
      return status in ['draft', 'published', 'archived'];
    }

    function isPublished() {
      return resource.data.status == 'published';
    }

    function isActivePublicRecord() {
      return resource.data.active == true;
    }

    function hasValidWriteTimestamps() {
      return request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function keepsCreatedAt() {
      return request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt is timestamp;
    }

    function validPublishableWrite() {
      return isValidContentStatus(request.resource.data.status)
        && hasValidWriteTimestamps();
    }

    function validPublishableUpdate() {
      return isValidContentStatus(request.resource.data.status)
        && keepsCreatedAt();
    }

    function validPublicAspiration() {
      return request.resource.data.keys().hasOnly([
          'category',
          'message',
          'senderName',
          'senderEmail',
          'isAnonymous',
          'status',
          'internalNotes',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.category is string
        && request.resource.data.category in ['akademik', 'fasilitas', 'organisasi', 'kesejahteraan', 'lainnya']
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 20
        && request.resource.data.message.size() <= 3000
        && request.resource.data.senderName is string
        && request.resource.data.senderName.size() <= 120
        && request.resource.data.senderEmail is string
        && request.resource.data.senderEmail.size() <= 254
        && request.resource.data.isAnonymous is bool
        && (request.resource.data.isAnonymous == false || (
          request.resource.data.senderName == '' && request.resource.data.senderEmail == ''
        ))
        && (request.resource.data.isAnonymous == true || request.resource.data.senderName.size() > 0)
        && request.resource.data.status == 'submitted'
        && request.resource.data.internalNotes == ''
        && hasValidWriteTimestamps();
    }

    function validAspirationUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'internalNotes',
          'updatedAt'
        ])
        && request.resource.data.status in [
          'submitted',
          'reviewed',
          'discussed',
          'in_progress',
          'resolved',
          'archived'
        ]
        && request.resource.data.internalNotes is string
        && request.resource.data.internalNotes.size() <= 5000
        && keepsCreatedAt();
    }

    /*
     * Direktori akun, bukan lagi sumber wewenang. Isinya cuma untuk ditampilkan
     * di panel; yang menentukan izin adalah claims di token.
     *
     * Tidak ada tulis dari klien sama sekali, termasuk oleh superadmin. Menulis
     * dokumen di sini tidak akan menggeser claims siapa pun, jadi satu-satunya
     * yang dihasilkan adalah daftar yang menjanjikan wewenang yang tidak
     * terpasang. Perubahan role wajib lewat /api/admin/accounts, yang menyetel
     * keduanya sekaligus.
     */
    match /adminUsers/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isSuperadmin());
      allow list: if isSuperadmin();
      allow write: if false;
    }

    match /articles/{documentId} {
      allow read: if isPublished() || hasActiveAdminProfile();
      allow create: if isEditor() && validPublishableWrite();
      allow update: if isEditor() && validPublishableUpdate();
      allow delete: if isEditor();
    }

    match /announcements/{documentId} {
      allow read: if isPublished() || hasActiveAdminProfile();
      allow create: if isEditor() && validPublishableWrite();
      allow update: if isEditor() && validPublishableUpdate();
      allow delete: if isEditor();
    }

    match /events/{documentId} {
      allow read: if isPublished() || hasActiveAdminProfile();
      allow create: if isEditor() && validPublishableWrite();
      allow update: if isEditor() && validPublishableUpdate();
      allow delete: if isEditor();
    }

    match /gallery/{documentId} {
      allow read: if isPublished() || hasActiveAdminProfile();
      allow create: if isEditor() && validPublishableWrite();
      allow update: if isEditor() && validPublishableUpdate();
      allow delete: if isEditor();
    }

    match /leaders/{documentId} {
      allow read: if isActivePublicRecord() || hasActiveAdminProfile();
      allow create: if canManageDivision(request.resource.data.get('divisionCode', ''))
        && hasValidWriteTimestamps();
      allow update: if ownsDivisionChange() && keepsCreatedAt();
      allow delete: if ownsExistingDivision();
    }

    // Kontak pribadi pengurus. Tidak ada `allow read` untuk publik sama sekali,
    // dan itulah seluruh alasan collection ini terpisah dari `leaders`: rules
    // Firestore tidak bisa menyembunyikan satu field dari dokumen yang boleh
    // dibaca publik, jadi field-nya yang harus pindah rumah.
    match /leaderContacts/{documentId} {
      allow read: if hasActiveAdminProfile();
      allow create: if canManageDivision(request.resource.data.get('divisionCode', ''))
        && hasValidWriteTimestamps();
      allow update: if ownsDivisionChange() && keepsCreatedAt();
      allow delete: if ownsExistingDivision();
    }

    // Superadmin saja. Daftar unsur organisasi adalah kerangka yang dipakai
    // seluruh situs, dan `divisionCode` di sini yang menentukan batas wewenang
    // semua editor. Membiarkan editor mengubahnya berarti membiarkan mereka
    // menggeser pagarnya sendiri.
    match /divisions/{documentId} {
      allow read: if isActivePublicRecord() || hasActiveAdminProfile();
      allow create: if isSuperadmin() && hasValidWriteTimestamps();
      allow update: if isSuperadmin() && keepsCreatedAt();
      allow delete: if isSuperadmin();
    }

    match /programs/{documentId} {
      allow read: if isActivePublicRecord() || hasActiveAdminProfile();
      allow create: if canManageDivision(request.resource.data.get('divisionCode', ''))
        && hasValidWriteTimestamps();
      allow update: if ownsDivisionChange() && keepsCreatedAt();
      allow delete: if ownsExistingDivision();
    }

    match /partners/{documentId} {
      allow read: if isActivePublicRecord() || hasActiveAdminProfile();
      allow create: if isEditor() && hasValidWriteTimestamps();
      allow update: if isEditor() && keepsCreatedAt();
      allow delete: if isEditor();
    }

    match /aspirations/{documentId} {
      allow create: if validPublicAspiration() || (isEditor() && hasValidWriteTimestamps());
      allow read: if hasActiveAdminProfile();
      allow update: if isEditor() && validAspirationUpdate();
      allow delete: if isSuperadmin();
    }

    /*
     * `settings/site` terbaca publik. Isinya memang untuk dibaca publik: nama
     * kabinet, periode, kanal resmi, dan teks yang tampil di kaki setiap
     * halaman. Halaman publik dirender di server, tapi Firestore tidak bisa
     * membedakan pembaca server dari pembaca browser, jadi membukanya adalah
     * satu-satunya cara.
     *
     * Karena itu dipisah per dokumen, bukan seluruh collection. Dokumen
     * pengaturan lain yang mungkin ditambahkan nanti tidak ikut terbuka hanya
     * karena kebetulan tinggal di collection yang sama.
     */
    match /settings/site {
      allow read: if true;
      allow create: if isSuperadmin() && hasValidWriteTimestamps();
      allow update: if isSuperadmin() && keepsCreatedAt();
      allow delete: if isSuperadmin();
    }

    match /settings/{documentId} {
      allow read: if hasActiveAdminProfile();
      allow create: if isSuperadmin() && hasValidWriteTimestamps();
      allow update: if isSuperadmin() && keepsCreatedAt();
      allow delete: if isSuperadmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
