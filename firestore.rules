rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    /*
     * Wewenang dibaca dari custom claims di token, bukan dari dokumen Firestore.
     *
     * Sebelumnya tiap pemeriksaan memanggil get() ke adminUsers/{uid}. Itu
     * berarti akun baru tidak bisa berbuat apa-apa sampai ada yang membuatkan
     * dokumennya dengan tangan, dan tiap operasi tulis membayar pembacaan
     * tambahan. Claims ikut di dalam token yang sudah ditandatangani Google,
     * jadi jawabannya sudah ada sebelum basis data disentuh.
     *
     * Claims hanya bisa dipasang Admin SDK lewat /api/admin/accounts. Klien
     * tidak punya cara mengarangnya sendiri.
     *
     * Memakai .get() dengan nilai bawaan, bukan akses field langsung: token
     * tanpa claims sama sekali adalah keadaan yang normal (pengunjung biasa),
     * dan akses field yang tidak ada membuat seluruh aturan gagal dievaluasi.
     */
    function adminRole() {
      return isSignedIn() ? request.auth.token.get('role', '') : '';
    }

    function hasActiveAdminProfile() {
      return adminRole() in ['superadmin', 'editor', 'viewer'];
    }

    function hasRole(roles) {
      return adminRole() in roles;
    }

    function isEditor() {
      return hasRole(['superadmin', 'editor']);
    }

    function isSuperadmin() {
      return hasRole(['superadmin']);
    }

    /* Role menentukan tingkat tindakan; permissions menentukan modulnya. */
    function defaultAdminPermissions() {
      return adminRole() == 'editor'
        ? ['media', 'programs']
        : [
            'pages', 'announcements', 'articles', 'publicData', 'gallery',
            'media', 'downloads', 'leaders', 'programs', 'divisions',
            'aspirations', 'history'
          ];
    }

    function adminPermissions() {
      return isSignedIn()
        ? request.auth.token.get('permissions', defaultAdminPermissions())
        : [];
    }

    function hasAdminPermission(permission) {
      return isSuperadmin() || adminPermissions().hasAny([permission]);
    }

    function canManage(permission) {
      return isEditor() && hasAdminPermission(permission);
    }

    /*
     * Bidang yang dipegang akun ini. Akun nonaktif tidak punya `role` sama
     * sekali di claims-nya, jadi ia sudah gugur di adminRole() sebelum sampai
     * ke sini. Tidak ada bendera aktif kedua yang bisa terlupa diperiksa.
     */
    function adminDivisionCode() {
      return isSignedIn() ? request.auth.token.get('divisionCode', '') : '';
    }

    /*
     * Superadmin bebas. Editor hanya boleh menyentuh data bidangnya sendiri.
     *
     * Dokumen tanpa `divisionCode`, dan akun editor tanpa bidang, keduanya
     * jatuh ke string kosong dan ditolak. Ini disengaja: data yatim harus
     * ditangani superadmin, bukan jadi celah yang bisa diklaim editor mana pun
     * hanya karena bidangnya sama-sama kosong.
     */
    function canManageDivision(code) {
      return isSuperadmin()
        || (isEditor() && code is string && code != '' && adminDivisionCode() == code);
    }

    function ownsExistingDivision() {
      return canManageDivision(resource.data.get('divisionCode', ''));
    }

    /*
     * Perubahan harus dimiliki di kedua sisi. Tanpa pemeriksaan dua arah,
     * seorang editor bisa memindahkan pengurus bidang lain ke bidangnya, atau
     * membuang anggotanya sendiri ke bidang orang lain.
     */
    function ownsDivisionChange() {
      return canManageDivision(resource.data.get('divisionCode', ''))
        && canManageDivision(request.resource.data.get('divisionCode', ''));
    }

    function isValidContentStatus(status) {
      return status in ['draft', 'published', 'archived'];
    }

    function isPublished() {
      return resource.data.status == 'published';
    }

    function isActivePublicRecord() {
      return resource.data.active == true;
    }

    function hasValidWriteTimestamps() {
      return request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function keepsCreatedAt() {
      return request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt is timestamp;
    }

    function validPublishableWrite() {
      return isValidContentStatus(request.resource.data.status)
        && hasValidWriteTimestamps();
    }

    function validPublishableUpdate() {
      return isValidContentStatus(request.resource.data.status)
        && keepsCreatedAt();
    }

    function validPublicAspiration() {
      return request.resource.data.keys().hasOnly([
          'category',
          'message',
          'senderName',
          'senderEmail',
          'isAnonymous',
          'status',
          'internalNotes',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.category is string
        && request.resource.data.category in ['akademik', 'fasilitas', 'organisasi', 'kesejahteraan', 'lainnya']
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 20
        && request.resource.data.message.size() <= 3000
        && request.resource.data.senderName is string
        && request.resource.data.senderName.size() <= 120
        && request.resource.data.senderEmail is string
        && request.resource.data.senderEmail.size() <= 254
        && request.resource.data.isAnonymous is bool
        && (request.resource.data.isAnonymous == false || (
          request.resource.data.senderName == '' && request.resource.data.senderEmail == ''
        ))
        && (request.resource.data.isAnonymous == true || request.resource.data.senderName.size() > 0)
        && request.resource.data.status == 'submitted'
        && request.resource.data.internalNotes == ''
        && hasValidWriteTimestamps();
    }

    function validAspirationUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'internalNotes',
          'updatedAt'
        ])
        && request.resource.data.status in [
          'submitted',
          'reviewed',
          'discussed',
          'in_progress',
          'resolved',
          'archived'
        ]
        && request.resource.data.internalNotes is string
        && request.resource.data.internalNotes.size() <= 5000
        && keepsCreatedAt();
    }

    function isValidAuditAction(action) {
      return action in ['create', 'update', 'delete', 'restore'];
    }

    function isAuditedEntityType(entityType) {
      return entityType in [
        'announcements',
        'articles',
        'divisions',
        'gallery',
        'leaders',
        'media',
        'mediaSlots',
        'pageContents',
        'pageContentDrafts',
        'publicData',
        'partners',
        'programs',
        'settings',
        'siteSettingsDrafts'
      ];
    }

    function validAuditIdentity() {
      return request.resource.data.actorUid == request.auth.uid
        && request.resource.data.actorRole == adminRole()
        && request.resource.data.actorEmail is string
        && request.resource.data.entityId is string
        && request.resource.data.entityId.size() > 0
        && request.resource.data.entityType is string
        && isAuditedEntityType(request.resource.data.entityType)
        && isValidAuditAction(request.resource.data.action)
        && request.resource.data.changedFields is list
        && request.resource.data.changedFields.size() <= 100
        && hasValidWriteTimestamps();
    }

    /*
     * Direktori akun, bukan lagi sumber wewenang. Isinya cuma untuk ditampilkan
     * di panel; yang menentukan izin adalah claims di token.
     *
     * Tidak ada tulis dari klien sama sekali, termasuk oleh superadmin. Menulis
     * dokumen di sini tidak akan menggeser claims siapa pun, jadi satu-satunya
     * yang dihasilkan adalah daftar yang menjanjikan wewenang yang tidak
     * terpasang. Perubahan role wajib lewat /api/admin/accounts, yang menyetel
     * keduanya sekaligus.
     */
    match /adminUsers/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isSuperadmin());
      allow list: if isSuperadmin();
      allow write: if false;
    }

    match /articles/{documentId} {
      allow read: if isPublished() || hasActiveAdminProfile();
      allow create: if canManage('articles') && validPublishableWrite();
      allow update: if canManage('articles') && validPublishableUpdate();
      allow delete: if canManage('articles');
    }

    match /announcements/{documentId} {
      allow read: if isPublished() || hasActiveAdminProfile();
      allow create: if canManage('announcements') && validPublishableWrite();
      allow update: if canManage('announcements') && validPublishableUpdate();
      allow delete: if canManage('announcements');
    }

    match /publicData/{documentId} {
      allow read: if isPublished() || hasActiveAdminProfile();
      allow create: if canManage('publicData') && validPublishableWrite();
      allow update: if canManage('publicData') && validPublishableUpdate();
      allow delete: if canManage('publicData');
    }

    match /gallery/{documentId} {
      allow read: if isPublished() || hasActiveAdminProfile();
      allow create: if canManage('gallery') && validPublishableWrite();
      allow update: if canManage('gallery') && validPublishableUpdate();
      allow delete: if canManage('gallery');
    }

    /*
     * Metadata media tidak perlu dibuka ke publik. Halaman publik menerima URL
     * dari dokumen kontennya; pustaka lengkap hanya berguna bagi admin.
     */
    match /media/{documentId} {
      allow read: if hasActiveAdminProfile();
      allow create: if canManage('media') && hasValidWriteTimestamps();
      allow update: if canManage('media') && keepsCreatedAt();
      allow delete: if isSuperadmin();
    }

    /*
     * Slot hanya berisi penempatan aset publik, jadi aman dibaca tanpa login.
     * Assignment berdampak ke banyak halaman sekaligus dan dikunci untuk
     * superadmin. Editor hanya boleh menyinkronkan proyeksi aman dari media
     * yang assignment-nya sudah ditentukan.
     */
    match /mediaSlots/{documentId} {
      allow read: if true;
      allow create: if isSuperadmin() && hasValidWriteTimestamps();
      allow update: if keepsCreatedAt() && (
        isSuperadmin()
        || (isEditor()
          && (hasAdminPermission('media') || hasAdminPermission('pages'))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'mediaUrl',
            'mediaAlt',
            'mediaWidth',
            'mediaHeight',
            'focalPointX',
            'focalPointY',
            'updatedAt'
          ]))
      );
      allow delete: if isSuperadmin();
    }

    match /auditLogs/{documentId} {
      allow read: if hasActiveAdminProfile();
      allow create: if isEditor()
        && validAuditIdentity()
        && request.resource.data.revisionId is string
        && request.resource.data.revisionId.size() > 0
        && request.resource.data.summary is string
        && request.resource.data.summary.size() <= 500;
      allow update, delete: if false;
    }

    match /contentRevisions/{documentId} {
      allow read: if hasActiveAdminProfile();
      allow create: if isEditor()
        && validAuditIdentity()
        && (request.resource.data.before == null || request.resource.data.before is map)
        && (request.resource.data.after == null || request.resource.data.after is map);
      allow update, delete: if false;
    }

    match /leaders/{documentId} {
      allow read: if isActivePublicRecord() || hasActiveAdminProfile();
      allow create: if canManage('leaders')
        && canManageDivision(request.resource.data.get('divisionCode', ''))
        && hasValidWriteTimestamps();
      allow update: if canManage('leaders') && ownsDivisionChange() && keepsCreatedAt();
      allow delete: if canManage('leaders') && ownsExistingDivision();
    }

    // Kontak pribadi pengurus. Tidak ada `allow read` untuk publik sama sekali,
    // dan itulah seluruh alasan collection ini terpisah dari `leaders`: rules
    // Firestore tidak bisa menyembunyikan satu field dari dokumen yang boleh
    // dibaca publik, jadi field-nya yang harus pindah rumah.
    match /leaderContacts/{documentId} {
      allow read: if hasActiveAdminProfile();
      allow create: if canManage('leaders')
        && canManageDivision(request.resource.data.get('divisionCode', ''))
        && hasValidWriteTimestamps();
      allow update: if canManage('leaders') && ownsDivisionChange() && keepsCreatedAt();
      allow delete: if canManage('leaders') && ownsExistingDivision();
    }

    // Superadmin saja. Daftar unsur organisasi adalah kerangka yang dipakai
    // seluruh situs, dan `divisionCode` di sini yang menentukan batas wewenang
    // semua editor. Membiarkan editor mengubahnya berarti membiarkan mereka
    // menggeser pagarnya sendiri.
    match /divisions/{documentId} {
      allow read: if isActivePublicRecord() || hasActiveAdminProfile();
      allow create: if isSuperadmin() && hasValidWriteTimestamps();
      allow update: if isSuperadmin() && keepsCreatedAt();
      allow delete: if isSuperadmin();
    }

    match /programs/{documentId} {
      allow read: if isActivePublicRecord() || hasActiveAdminProfile();
      allow create: if canManage('programs')
        && canManageDivision(request.resource.data.get('divisionCode', ''))
        && hasValidWriteTimestamps();
      allow update: if canManage('programs') && ownsDivisionChange() && keepsCreatedAt();
      allow delete: if canManage('programs') && ownsExistingDivision();
    }

    match /partners/{documentId} {
      allow read: if isActivePublicRecord() || hasActiveAdminProfile();
      allow create: if canManage('pages') && hasValidWriteTimestamps();
      allow update: if canManage('pages') && keepsCreatedAt();
      allow delete: if canManage('pages');
    }

    match /aspirations/{documentId} {
      allow create: if validPublicAspiration() || (canManage('aspirations') && hasValidWriteTimestamps());
      allow read: if hasActiveAdminProfile();
      allow update: if canManage('aspirations') && validAspirationUpdate();
      allow delete: if isSuperadmin();
    }

    /*
     * `settings/site` terbaca publik. Isinya memang untuk dibaca publik: nama
     * kabinet, periode, kanal resmi, dan teks yang tampil di kaki setiap
     * halaman. Halaman publik dirender di server, tapi Firestore tidak bisa
     * membedakan pembaca server dari pembaca browser, jadi membukanya adalah
     * satu-satunya cara.
     *
     * Karena itu dipisah per dokumen, bukan seluruh collection. Dokumen
     * pengaturan lain yang mungkin ditambahkan nanti tidak ikut terbuka hanya
     * karena kebetulan tinggal di collection yang sama.
     */
    match /settings/site {
      allow read: if true;
      allow create: if isSuperadmin() && hasValidWriteTimestamps();
      allow update: if isSuperadmin() && keepsCreatedAt();
      allow delete: if isSuperadmin();
    }

    match /settings/{documentId} {
      allow read: if hasActiveAdminProfile();
      allow create: if isSuperadmin() && hasValidWriteTimestamps();
      allow update: if isSuperadmin() && keepsCreatedAt();
      allow delete: if isSuperadmin();
    }

    // Draf global tidak pernah dibuka ke publik. Superadmin dapat menyimpan
    // progres tanpa mengubah dokumen terbit `settings/site`.
    match /siteSettingsDrafts/{documentId} {
      allow read: if hasActiveAdminProfile();
      allow create: if isSuperadmin() && hasValidWriteTimestamps();
      allow update: if isSuperadmin() && keepsCreatedAt();
      allow delete: if isSuperadmin();
    }

    // Konten halaman terbit dapat dibaca publik. Editor boleh mengelola copy,
    // urutan, dan visibilitas; perubahan slot gambar tetap dibatasi rules
    // `mediaSlots` serta divalidasi lagi oleh alur publish di panel.
    match /pageContents/{documentId} {
      allow read: if true;
      allow create: if canManage('pages') && hasValidWriteTimestamps();
      allow update: if canManage('pages') && keepsCreatedAt();
      allow delete: if isSuperadmin();
    }

    // Draf halaman hanya tersedia bagi admin aktif dan tidak pernah dibaca
    // renderer publik.
    match /pageContentDrafts/{documentId} {
      allow read: if hasActiveAdminProfile();
      allow create: if canManage('pages') && hasValidWriteTimestamps();
      allow update: if canManage('pages') && keepsCreatedAt();
      allow delete: if isSuperadmin();
    }

    /*
     * Daftar berkas unduhan. Terbaca publik karena /unduhan dirender server dan
     * Firestore tidak bisa membedakan pembaca server dari pembaca browser.
     *
     * Tidak diaudit: isinya daftar tautan, bukan konten redaksional. Kalau audit
     * kelak ditambahkan, `downloads` harus masuk auditedContentCollections DAN
     * isAuditedEntityType() dalam satu perubahan — setengahnya membuat setiap
     * simpan gagal karena batch audit ditolak.
     */
    match /downloads/{documentId} {
      allow read: if true;
      allow create: if canManage('downloads') && hasValidWriteTimestamps();
      allow update: if canManage('downloads') && keepsCreatedAt();
      allow delete: if isSuperadmin();
    }

    /*
     * Dokumen induk arsip: berisi project privat lengkap dengan judul dan jalur
     * berkasnya. Tidak boleh terbaca publik sama sekali.
     *
     * Halaman /arsip TIDAK membaca koleksi ini. Ia membaca `downloads/index`
     * yang sudah disaring, dan isi privat baru diambil dari sini lewat Admin SDK
     * setelah kode akses terbukti. Kalau suatu saat halaman publik mulai
     * membaca koleksi ini dengan SDK klien, seluruh gerbangnya runtuh.
     */
    match /downloadsPrivate/{documentId} {
      allow read: if hasActiveAdminProfile();
      allow create: if canManage('downloads') && hasValidWriteTimestamps();
      allow update: if canManage('downloads') && keepsCreatedAt();
      allow delete: if isSuperadmin();
    }

    /*
     * Sidik jari kode akses arsip. Tertutup untuk semua orang, termasuk
     * superadmin yang sedang masuk panel.
     *
     * Bukan karena admin tidak boleh tahu, melainkan karena tidak ada yang
     * perlu membacanya: kode dipasang lewat /api/admin/arsip-kode dan dibuktikan
     * lewat /api/arsip/buka, keduanya memakai Admin SDK yang melewati berkas ini
     * sepenuhnya. Menutupnya di sini berarti turunan scrypt-nya tidak pernah
     * ikut terbawa satu pun jawaban Firestore ke browser.
     */
    match /archiveAccess/{projectId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
